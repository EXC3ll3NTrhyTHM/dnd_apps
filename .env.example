# Copy this to .env.<character> (e.g., .env.nibby, .env.bonesy)

# Discord bot token (each character needs its own bot application)
DISCORD_TOKEN=your_discord_bot_token

# OpenAI API key (can be shared across characters)
OPENAI_API_KEY=your_openai_api_key

# Model to use (optional, defaults to gpt-4o-mini)
MODEL=gpt-4o-mini
